<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_test_bg_service_compute_power_tree" model="ir.ui.view">
        <field name="model">test.bg.service.compute.power</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_created"/>
                <field name="date_completed"/>
                <field name="base"/>
                <field name="power"/>
                <field name="result"/>
            </tree>
        </field>
    </record>

    <record id="view_test_bg_service_compute_power_form" model="ir.ui.view">
        <field name="model">test.bg.service.compute.power</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date_created" readonly="1"/>
                        <field name="date_completed" readonly="1"/>
                    </group>
                    <group>
                        <field name="base"/>
                        <field name="power"/>
                        <field name="result" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_test_bg_service_compute_power" model="ir.actions.act_window">
        <field name="name">Test BG Service: Compute Power</field>
        <field name="res_model">test.bg.service.compute.power</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Generic Background Service Tests"
              id="generic_background_service_tests"
              sequence="50"
              parent="base.menu_tests"/>

    <menuitem name="Generic Background Service: Compute Power"
              id="generic_background_service_tests__compute_power"
              sequence="30"
              parent="generic_background_service_tests"
              action="action_test_bg_service_compute_power"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Task Tree View -->
    <record id="view_generic_task_queue_task_tree" model="ir.ui.view">
        <field name="name">generic.task.queue.task.tree</field>
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'running'">
                <field name="name"/>
                <field name="type_code"/>
                <field name="state"/>
                <field name="channel"/>
                <field name="priority"/>
                <field name="progress" widget="progressbar"/>
                <field name="worker_id"/>
                <field name="retry_count"/>
                <field name="create_uid"/>
                <field name="date_created"/>
                <field name="date_started"/>
                <field name="date_completed"/>
            </list>
        </field>
    </record>

    <!-- Task Form View -->
    <record id="view_generic_task_queue_task_form" model="ir.ui.view">
        <field name="name">generic.task.queue.task.form</field>
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('pending', 'assigned', 'running')"
                            confirm="Are you sure you want to cancel this task?"/>
                    <button name="action_retry"
                            string="Retry"
                            type="object"
                            invisible="state != 'failed'"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,assigned,running,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Task">
                            <field name="name"/>
                            <field name="type_code"/>
                            <field name="channel"/>
                            <field name="priority"/>
                            <field name="eta"/>
                            <field name="timeout"/>
                        </group>
                        <group string="Execution">
                            <field name="worker_id"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="retry_policy"/>
                            <field name="max_retries"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Parameters">
                        <field name="task_params" widget="json"/>
                    </group>
                    <group string="Result"
                           invisible="state not in ('done', 'failed')">
                        <field name="task_result" widget="json"
                               invisible="state != 'done'"/>
                        <field name="task_error"
                               invisible="state != 'failed'"/>
                    </group>
                    <group string="Dates">
                        <field name="date_created"/>
                        <field name="date_started"/>
                        <field name="date_completed"/>
                    </group>
                    <group string="Sub-tasks"
                           invisible="not child_ids">
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="state"/>
                                <field name="progress" widget="progressbar"/>
                            </list>
                        </field>
                    </group>
                    <field name="parent_id" invisible="not parent_id"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_generic_task_queue_task_search" model="ir.ui.view">
        <field name="name">generic.task.queue.task.search</field>
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_code"/>
                <field name="channel"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="running" string="Running"
                        domain="[('state', '=', 'running')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_channel" string="Channel"
                            context="{'group_by': 'channel'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'type_code'}"/>
                    <filter name="group_worker" string="Worker"
                            context="{'group_by': 'worker_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Action -->
    <record id="action_generic_task_queue_task" model="ir.actions.act_window">
        <field name="name">Task Queue</field>
        <field name="res_model">generic.task.queue.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_generic_task_queue_task_search"/>
    </record>

    <!-- Worker Tree View -->
    <record id="view_generic_task_queue_worker_tree" model="ir.ui.view">
        <field name="name">generic.task.queue.worker.tree</field>
        <field name="model">generic.task.queue.worker</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-danger="state == 'dead'"
                  decoration-warning="state == 'stale'">
                <field name="name"/>
                <field name="service_name"/>
                <field name="dbname"/>
                <field name="state"/>
                <field name="max_parallel_jobs"/>
                <field name="channels"/>
                <field name="task_types"/>
                <field name="last_heartbeat"/>
            </list>
        </field>
    </record>

    <!-- Worker Action -->
    <record id="action_generic_task_queue_worker" model="ir.actions.act_window">
        <field name="name">Task Workers</field>
        <field name="res_model">generic.task.queue.worker</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_task_queue_root"
              name="Task Queue"
              sequence="90"/>
    <menuitem id="menu_task_queue_tasks"
              name="Tasks"
              parent="menu_task_queue_root"
              action="action_generic_task_queue_task"
              sequence="10"/>
    <menuitem id="menu_task_queue_workers"
              name="Workers"
              parent="menu_task_queue_root"
              action="action_generic_task_queue_worker"
              sequence="20"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Task Tree View -->
    <record id="view_generic_task_queue_task_tree" model="ir.ui.view">
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <list default_order="id desc" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'" decoration-info="state == 'running'" decoration-warning="state == 'stuck'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="state"/>
                <field name="progress" widget="gtq_task_progress"/>
                <field name="channel"/>
                <field name="priority"/>
                <field name="worker_id" groups="generic_task_queue.group_task_queue_manager"/>
                <field name="retry_count"/>
                <field name="create_uid"/>
                <field name="date_created"/>
                <field name="date_started"/>
                <field name="date_completed"/>
            </list>
        </field>
    </record>

    <!-- Task Form View -->
    <record id="view_generic_task_queue_task_form" model="ir.ui.view">
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" string="Cancel" type="object" groups="generic_task_queue.group_task_queue_user" invisible="state not in ('pending', 'assigned', 'running', 'stuck', 'waiting')" confirm="Are you sure you want to cancel this task?"/>
                    <button name="action_retry" string="Retry" type="object" groups="generic_task_queue.group_task_queue_user" invisible="state != 'failed'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,assigned,running,stuck,waiting,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_child_tasks" type="object" class="oe_stat_button" icon="fa-tasks" invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="Sub-tasks"/>
                        </button>
                        <button name="action_open_parent_task" type="object" class="oe_stat_button" icon="fa-level-up" invisible="not parent_id" string="Parent Task"/>
                    </div>
                    <group>
                        <group string="Task">
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="channel"/>
                            <field name="priority"/>
                            <field name="eta"/>
                            <field name="timeout"/>
                            <field name="parent_id" invisible="not parent_id"/>
                        </group>
                        <group string="Execution">
                            <field name="worker_id" groups="generic_task_queue.group_task_queue_manager"/>
                            <field name="runner_id" groups="generic_task_queue.group_task_queue_manager" invisible="not runner_id"/>
                            <field name="progress" widget="gtq_task_progress"/>
                            <field name="retry_policy"/>
                            <field name="max_retries"/>
                            <field name="retry_count"/>
                            <field name="create_uid" string="Created by" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <group string="Parameters" groups="generic_task_queue.group_task_queue_manager">
                        <field name="task_params"/>
                    </group>
                    <group string="Result" groups="generic_task_queue.group_task_queue_manager" invisible="state not in ('done', 'failed')">
                        <field name="task_result" invisible="state != 'done'"/>
                        <field name="task_error" invisible="state != 'failed'"/>
                    </group>
                    <group string="Dates">
                        <field name="date_created"/>
                        <field name="date_started"/>
                        <field name="date_completed"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_generic_task_queue_task_search" model="ir.ui.view">
        <field name="model">generic.task.queue.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="channel"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="stuck" string="Stuck" domain="[('state', '=', 'stuck')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_worker" string="Worker" context="{'group_by': 'worker_id'}" groups="generic_task_queue.group_task_queue_manager"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Action (all tasks — managers only) -->
    <record id="action_generic_task_queue_task" model="ir.actions.act_window">
        <field name="name">Task Queue</field>
        <field name="res_model">generic.task.queue.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_generic_task_queue_task_search"/>
    </record>

    <!-- My Tasks Action (own tasks — task queue users) -->
    <record id="action_generic_task_queue_my_tasks" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">generic.task.queue.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="search_view_id" ref="view_generic_task_queue_task_search"/>
    </record>

    <!-- Worker Tree View -->
    <record id="view_generic_task_queue_worker_tree" model="ir.ui.view">
        <field name="name">generic.task.queue.worker.tree</field>
        <field name="model">generic.task.queue.worker</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-danger="state == 'dead'" decoration-warning="state == 'stuck'">
                <field name="name"/>
                <field name="service_name"/>
                <field name="hostname"/>
                <field name="dbname"/>
                <field name="state"/>
                <field name="max_parallel_jobs"/>
                <field name="channels"/>
                <field name="task_types"/>
                <field name="last_heartbeat"/>
            </list>
        </field>
    </record>

    <!-- Worker Action -->
    <record id="action_generic_task_queue_worker" model="ir.actions.act_window">
        <field name="name">Task Workers</field>
        <field name="res_model">generic.task.queue.worker</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Task Type List View -->
    <record id="view_generic_task_queue_task_type_tree" model="ir.ui.view">
        <field name="name">generic.task.queue.task.type.tree</field>
        <field name="model">generic.task.queue.task.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="module"/>
                <field name="default_retry_policy"/>
                <field name="default_max_retries"/>
                <field name="default_timeout"/>
                <field name="notify_on_completion"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Task Type Form View -->
    <record id="view_generic_task_queue_task_type_form" model="ir.ui.view">
        <field name="name">generic.task.queue.task.type.form</field>
        <field name="model">generic.task.queue.task.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="module"/>
                            <field name="active"/>
                        </group>
                        <group string="Defaults (defined in code)">
                            <field name="default_retry_policy"/>
                            <field name="default_max_retries"/>
                            <field name="default_timeout"/>
                            <field name="notify_on_completion"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Type Action -->
    <record id="action_generic_task_queue_task_type" model="ir.actions.act_window">
        <field name="name">Task Types</field>
        <field name="res_model">generic.task.queue.task.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_task_queue_root" name="Task Queue" groups="generic_task_queue.group_task_queue_user" sequence="90"/>
    <menuitem id="menu_task_queue_my_tasks" name="My Tasks" parent="menu_task_queue_root" action="action_generic_task_queue_my_tasks" groups="generic_task_queue.group_task_queue_user" sequence="5"/>
    <menuitem id="menu_task_queue_tasks" name="Tasks" parent="menu_task_queue_root" action="action_generic_task_queue_task" groups="generic_task_queue.group_task_queue_manager" sequence="10"/>
    <menuitem id="menu_task_queue_task_types" name="Task Types" parent="menu_task_queue_root" action="action_generic_task_queue_task_type" groups="generic_task_queue.group_task_queue_manager" sequence="15"/>
    <menuitem id="menu_task_queue_workers" name="Workers" parent="menu_task_queue_root" action="action_generic_task_queue_worker" groups="generic_task_queue.group_task_queue_manager" sequence="20"/>

</odoo>

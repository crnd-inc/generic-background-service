<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="generic_task_queue.TaskProgressWidget">
        <div class="gtq-task-progress d-flex align-items-center gap-2">
            <span t-if="this.isActive"
                  class="oi oi-spin text-muted" data-icon="progress_activity"
                  style="cursor: pointer;"
                  title="Click to refresh"
                  t-on-click="this.onClickReload"/>
            <div class="progress flex-grow-1" style="height: 6px;">
                <div
                    class="progress-bar"
                    role="progressbar"
                    t-att-style="'width: ' + this.displayProgress + '%'"
                    t-att-aria-valuenow="this.displayProgress"
                    aria-valuemin="0"
                    aria-valuemax="100"
                />
            </div>
            <small class="text-muted" t-out="this.displayProgress + '%'"/>
        </div>
    </t>
</templates>

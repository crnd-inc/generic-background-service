<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="generic_task_queue.TaskProgressWidget">
        <div class="gtq-task-progress d-flex align-items-center gap-2">
            <span t-if="isActive" class="fa fa-spinner fa-spin text-muted"/>
            <div class="progress flex-grow-1" style="height: 6px;">
                <div
                    class="progress-bar"
                    role="progressbar"
                    t-att-style="'width: ' + displayProgress + '%'"
                    t-att-aria-valuenow="displayProgress"
                    aria-valuemin="0"
                    aria-valuemax="100"
                />
            </div>
            <small class="text-muted" t-out="displayProgress + '%'"/>
        </div>
    </t>
</templates>
